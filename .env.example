# 이 파일을 .env 로 복사해 채운다. .env 는 커밋하지 않는다.
# 시험 기동은 GATEWAY_PORT 를 비워 두고(4710), 기존 게이트웨이를 내리고 교체할 때 4701 로 바꾼다.
GATEWAY_PORT=4710

# 필수. 마스터 키는 추측하기 어려운 긴 값으로(예: openssl rand -hex 32 앞에 sk- 를 붙인다)
GATEWAY_MASTER_KEY=
POSTGRES_PASSWORD=

# 로그인 방식은 빌드 때 정해진다(설계 6장). 기본 빌드(./build.sh)는 SSO 가 들어 있어 아래 세 값 중
# ISSUER·CLIENT_ID 가 비면 기동하지 않는다. SSO 를 쓰지 않으려면 LOGIN=password ./build.sh 로 빌드하고 이 값들은 비워 둔다.
# GATEWAY_PUBLIC_URL 은 브라우저가 게이트웨이를 여는 주소다(예: http://203.0.113.10:4701)
GATEWAY_PUBLIC_URL=
GATEWAY_SSO_ISSUER=
GATEWAY_SSO_CLIENT_ID=
GATEWAY_SSO_CLIENT_SECRET=
