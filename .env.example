# 이 파일을 .env 로 복사해 채운다. .env 는 커밋하지 않는다.
# 시험 기동은 GATEWAY_PORT 를 비워 두고(4710), 기존 게이트웨이를 내리고 교체할 때 4701 로 바꾼다.
GATEWAY_PORT=4710

# 필수. 마스터 키는 추측하기 어려운 긴 값으로(예: openssl rand -hex 32 앞에 sk- 를 붙인다)
GATEWAY_MASTER_KEY=
POSTGRES_PASSWORD=

# 앞단 프록시(nginx 등) 뒤에 둘 때만 채운다. 그 프록시의 IP 또는 CIDR(쉼표로 여러 개). 비워 두면(게이트웨이를 직접 열 때)
# X-Forwarded-For 를 믿지 않는다. 앞단 뒤인데 비워 두면 로그인 시도 제한이 모든 사용자에게 한꺼번에 걸린다.
# 앞단은 proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; 로 헤더를 덧붙여야 한다
GATEWAY_TRUSTED_PROXIES=

# IP 허용 목록은 대시보드에서 정한다(목록이 비면 모두 허용). 목록에서 자기 IP 를 빼고 저장해 잠겼을 때만 true 로 두고 다시 띄운다.
# 같은 서버에서 직접(앞단을 거치지 않고) 부르는 요청은 목록과 무관하게 허용되므로 먼저 그쪽으로 고쳐 보고, 안 되면 이 값을 쓴다
GATEWAY_ALLOWED_IPS_DISABLE=

# 로그인 방식: password(litellm 자체 로그인: 아이디·비밀번호), sso(Keycloak), sso,password(둘 다).
# 비워 두면 비밀번호는 켜고, 아래 GATEWAY_SSO_ISSUER 가 있을 때만 SSO 도 켠다. SSO 만 쓰는 곳은 sso 를 적는다
# (비워 두면 비밀번호 로그인이 함께 켜진다). sso 를 고르면 ISSUER·CLIENT_ID 가 필요하고 없으면 기동하지 않는다.
GATEWAY_LOGIN_METHODS=

# 한도 카운터 저장소: memory(게이트웨이 1대, 기본) 또는 redis(여러 대 — Redis 없이 여러 대를 띄우면 한도가 대수만큼 늘어난다).
# redis 면 주소가 필수이고 기동 때 연결을 확인한다. 예: redis://:비밀번호@cache:6379/0 (TLS 는 rediss://)
GATEWAY_COUNTER_STORE=memory
GATEWAY_REDIS_URL=

# SSO(Keycloak)를 고를 때 채운다. GATEWAY_PUBLIC_URL 은 브라우저가 게이트웨이를 여는 주소다(예: http://203.0.113.10:4701)
GATEWAY_PUBLIC_URL=
GATEWAY_SSO_ISSUER=
GATEWAY_SSO_CLIENT_ID=
GATEWAY_SSO_CLIENT_SECRET=
